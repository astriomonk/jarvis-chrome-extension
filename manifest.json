{
  "manifest_version": 3,
  "name": "JARVIS AI Assistant",
  "version": "1.1.3",
  "description": "A futuristic AI assistant available on your websites.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.fish.audio/*"
  ],
  "action": {
    "default_title": "Open JARVIS",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "jarvis.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-jarvis": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Toggle JARVIS"
    }
  }
}
